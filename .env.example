# Copy to .env and fill in. Never commit .env.

# Public URL of the web app. OAuth redirect URIs are built from this:
#   {PUBLIC_WEB_URL}/api/auth/google/callback
#   {PUBLIC_WEB_URL}/api/auth/microsoft/callback
#   {PUBLIC_WEB_URL}/api/connectors/oauth/callback
PUBLIC_WEB_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# none | minimal | low | medium | high. Leave empty to omit the parameter.
OPENAI_REASONING_EFFORT=none

# Google OAuth client (Web application) - console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra / Outlook app registration (Web platform)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Secrets. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Fernet key. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Infra (docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://assistant:assistant@postgres:5432/assistant
REDIS_URL=redis://redis:6379/0
LETTA_BASE_URL=http://letta:8283
LETTA_API_KEY=
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Agent computer. With E2B_API_KEY set, E2B Desktop is used (live desktop stream in the UI);
# COMPUTER_PROVIDER=daytona forces Daytona. Either key alone enables the computer.
COMPUTER_PROVIDER=e2b
E2B_API_KEY=
# Optional custom template (default: E2B's public "desktop" template)
E2B_TEMPLATE=
# Idle seconds before the sandbox pauses (Hobby max 3600, Pro max 86400); every tool call extends it.
E2B_SANDBOX_TIMEOUT=3600

# Daytona cloud sandbox (fallback agent computer)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Web search order (stages or provider names): free = brave, duckduckgo, wikipedia (keyless, server-side);
# browser = the same search in the cloud computer's browser; paid = tavily, brave_api, serper, exa (keyed).
SEARCH_ORDER=tavily,browser,free
# Time budgets (seconds): each free engine / all free engines / browser stage (warm) / browser stage incl. a cold
# boot / all paid providers. SEARCH_BROWSER_BOOT: auto (boot a stopped computer only if no paid key is left), always, never.
SEARCH_PROVIDER_TIMEOUT_S=8
SEARCH_FREE_TIMEOUT_S=15
SEARCH_BROWSER_TIMEOUT_S=45
SEARCH_BROWSER_COLD_TIMEOUT_S=120
SEARCH_BROWSER_BOOT=auto
SEARCH_PAID_TIMEOUT_S=20
# Paid search APIs, the last resort (Tavily first). Free engines often block server IPs, so set one as a backstop.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=

# Composio marketplace
COMPOSIO_API_KEY=

# GitHub goes through Composio (docs/GITHUB.md). Optional: pin the GitHub auth config (ac_...). Use a
# custom OAuth auth config with "Mask Connected Account Secrets" off if you want real git clone/push.
COMPOSIO_GITHUB_AUTH_CONFIG_ID=

# WhatsApp channel - docs/WHATSAPP.md. Leave empty to keep it off.
# Provider: twilio | meta (empty = twilio when TWILIO_ACCOUNT_SID is set, else meta)
WHATSAPP_PROVIDER=
# Public base URL the provider calls (Twilio signs it). Empty = PUBLIC_WEB_URL
WHATSAPP_PUBLIC_BASE_URL=
# --- Twilio. Webhook ("When a message comes in", POST): {base}/api/channels/whatsapp/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional API key for the REST API (falls back to account SID + auth token)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# WhatsApp sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=
# Optional Content template SIDs (HX...): quick-reply approvals {{1}} body, {{2}} approve id, {{3}} deny id;
# and an approved notice {{1}} for outside the 24h window
TWILIO_CONTENT_SID_APPROVAL=
TWILIO_CONTENT_SID_NOTIFY=
TWILIO_STATUS_CALLBACK=false
# --- Meta WhatsApp Business Cloud API. Webhook URL: {PUBLIC_WEB_URL}/api/channels/whatsapp/webhook
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token with whatsapp_business_messaging (+ whatsapp_business_management)
WHATSAPP_ACCESS_TOKEN=
# Meta app secret (App settings -> Basic); verifies X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into the Meta webhook "Verify token" field
WHATSAPP_VERIFY_TOKEN=
# The business number in E.164 digits (e.g. 15551234567), used for the wa.me link
WHATSAPP_BUSINESS_NUMBER=
# Optional approved template (one body parameter) used outside the 24h customer-service window
WHATSAPP_TEMPLATE_NOTIFY=
