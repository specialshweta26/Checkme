# Copy to .env and fill in. Never commit .env.

# Public URL of the web app. OAuth redirect URIs are built from this:
#   {PUBLIC_WEB_URL}/api/auth/google/callback
#   {PUBLIC_WEB_URL}/api/auth/microsoft/callback
#   {PUBLIC_WEB_URL}/api/connectors/oauth/callback
PUBLIC_WEB_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# none | minimal | low | medium | high. Leave empty to omit the parameter.
OPENAI_REASONING_EFFORT=none

# Google OAuth client (Web application) - console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra / Outlook app registration (Web platform)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Secrets. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Fernet key. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Infra (docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://assistant:assistant@postgres:5432/assistant
REDIS_URL=redis://redis:6379/0
LETTA_BASE_URL=http://letta:8283
LETTA_API_KEY=
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Agent computer. With E2B_API_KEY set, E2B Desktop is used (live desktop stream in the UI);
# COMPUTER_PROVIDER=daytona forces Daytona. Either key alone enables the computer.
COMPUTER_PROVIDER=e2b
E2B_API_KEY=
# Optional custom template (default: E2B's public "desktop" template)
E2B_TEMPLATE=
# Idle seconds before the sandbox pauses (Hobby max 3600, Pro max 86400); every tool call extends it.
E2B_SANDBOX_TIMEOUT=3600

# Daytona cloud sandbox (fallback agent computer)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Web search APIs, tried in this order before the keyless fallback (Brave HTML, DuckDuckGo, Wikipedia).
# Search engines block or rate-limit server IPs, so set at least one for reliable search.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=

# Composio marketplace
COMPOSIO_API_KEY=

# GitHub goes through Composio (docs/GITHUB.md). Optional: pin the GitHub auth config (ac_...). Use a
# custom OAuth auth config with "Mask Connected Account Secrets" off if you want real git clone/push.
COMPOSIO_GITHUB_AUTH_CONFIG_ID=
