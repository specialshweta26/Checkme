{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumio",
  "version": "0.1.0",
  "identifier": "app.lumio.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://checkme-web-kw68.onrender.com"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
